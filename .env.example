# Forumlify 环境变量示例
# 复制为 .env 并按需修改

# PostgreSQL 连接串（默认与 docker-compose.yml 一致）
DATABASE_URL=postgresql://forumlify:123456@localhost:5432/forumlify

# JWT 签名密钥（生产环境务必修改为随机长字符串）
JWT_SECRET=forumlify-secret-key-change-me-in-production

# 可选：监听端口/地址（也可在 config.js 中设置 SERVER_PORT / SERVER_HOST）
# PORT=3000
# HOST=0.0.0.0
