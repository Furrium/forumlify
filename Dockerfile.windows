# ============================================================
#  Forumlify (Next.js) Windows 容器镜像
#  构建：windows runner 切 Windows 容器引擎后 docker build
# ============================================================

# ---- 构建阶段 ----
FROM node:20-windowsservercore-ltsc2022 AS builder
WORKDIR C:/app
ENV DOCKER=1

# bun 装依赖（bun.lock 最新；npm 会读旧 package-lock.json → react 18 → 构建失败）
RUN npm install -g bun
COPY package.json bun.lock* package-lock.json* ./
RUN bun install
COPY . .
RUN bun run build

# ---- 运行阶段 ----
FROM node:20-windowsservercore-ltsc2022
WORKDIR C:/app
ENV NODE_ENV=production

# standalone 输出（含 server.js 与最小 node_modules）
COPY --from=builder C:/app/.next/standalone ./
COPY --from=builder C:/app/.next/static ./.next/static

RUN mkdir C:/app/uploads

EXPOSE 3000
CMD ["node", "server.js"]
